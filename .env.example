# AI Store Nexus — Environment Variables
# Copy this file to .env and fill in the values

# Database (SQLite)
DATABASE_URL=file:./db/custom.db

# Session signing secret (REQUIRED, min 16 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-here-at-least-16-chars

# Base path for the application
NEXT_PUBLIC_BASE_PATH=/aistore
NEXT_PUBLIC_BASE_URL=https://www.mybait.org/aistore

# Node environment
NODE_ENV=development

# b'AI'tcoin daemon URL (set in CGI env on HostGator)
# BAITCOIN_SERVER_URL=http://127.0.0.1:18445
