# Root .htaccess — HostGator
# CAUTION: Do NOT add 'Options +ExecCGI' here — causes 500 on shared hosting
# CGI handler is already enabled server-wide for .cgi files
AddHandler cgi-script .cgi

<IfModule mod_rewrite.c>
  RewriteEngine On

  # bAI'tcoin daemon (existing)
  RewriteCond %{REQUEST_URI} !^/aistore
  RewriteRule ^api/(.*)$ /api.cgi/$1 [QSA,L,E=PATH_INFO:/$1]

  # AI Store API — route through root-level CGI to avoid subdirectory CGI issues
  RewriteRule ^aistore/api/(.*)$ /aistore-api.cgi/$1 [QSA,L,E=PATH_INFO:/$1]
  RewriteRule ^aistore/test\.cgi$ /aistore-test.cgi [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

ErrorDocument 404 /index.html
