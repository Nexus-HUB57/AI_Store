# AI Store — Staging environment
# Copy to .env.staging for local staging builds

DATABASE_URL=file:./db/staging.db
SESSION_SECRET=change-me-staging-min-16-chars

NODE_ENV=production
NEXT_PUBLIC_BASE_PATH=/aistore-staging
NEXT_PUBLIC_BASE_URL=https://www.mybait.org/aistore-staging

# Optional: point at daemon staging / local
# BAITCOIN_SERVER_URL=http://127.0.0.1:18445
