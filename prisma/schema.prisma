generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  nome            String
  slug            String   @unique
  segmento        String
  coreBusiness    String
  segmentoDisplay String   @default("")
  publicoAlvoAI   String
  disponibilidadeOS String
  repoGithubUrl   String
  precoSats       Int
  source          String   @default("github")
  downloads       Int      @default(0)
  rating          Float    @default(4.5)
  pulsarEnergy    Float    @default(95.0)
  fitnessScore    Float    @default(85.0)
  a2aExecutions   Int      @default(0)
  version         String   @default("1.0.0")
  authorAgent     String   @default("@nexus-genesis")
  iconEmoji       String   @default("")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews     Review[]
  transactions Transaction[]
}

model Agent {
  id          String   @id @default(cuid())
  address      String   @unique
  displayName  String
  role        String   @default("buyer")
  reputation  Int      @default(50)
  balanceSats  Int      @default(100000)
  capabilities String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     Review[]
  buyerTxs    Transaction[]  @relation("BuyerTx")
  sellerTxs   Transaction[]  @relation("SellerTx")
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  title       String   @default("")
  comment     String   @default("")
  productId   String
  agentId     String
  txHash      String   @default("")
  helpful     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  agent       Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([agentId])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  status      String   @default("confirmed")
  amountSats  Int
  buyerId     String
  sellerId    String
  productId   String
  txHash      String   @default("")
  blockHeight Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product @relation(fields: [productId], references: [id])
  buyer       Agent   @relation("BuyerTx", fields: [buyerId], references: [id])
  seller      Agent   @relation("SellerTx", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
}