generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  nome            String
  slug            String   @unique
  segmento        String
  coreBusiness    String
  segmentoDisplay String   @default("")
  publicoAlvoAI   String
  disponibilidadeOS String
  repoGithubUrl   String
  precoSats       Int
  source          String   @default("github")
  downloads       Int      @default(0)
  rating          Float    @default(4.5)
  pulsarEnergy    Float    @default(95.0)
  fitnessScore    Float    @default(85.0)
  a2aExecutions   Int      @default(0)
  version         String   @default("1.0.0")
  authorAgent     String   @default("@nexus-genesis")
  iconEmoji       String   @default("")
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews     Review[]
  transactions Transaction[]
}

model Agent {
  id            String   @id @default(cuid())
  address       String   @unique
  displayName   String
  role          String   @default("buyer")
  reputation    Int      @default(50)
  balanceSats   Int      @default(100000)
  capabilities  String   @default("[]")
  referralCode  String   @unique @default("")
  referredBy    String   @default("")
  purchaseCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews          Review[]
  buyerTxs         Transaction[]  @relation("BuyerTx")
  sellerTxs        Transaction[]  @relation("SellerTx")
  referralRewards  ReferralReward[] @relation("Referrer")
  referralReceived ReferralReward[] @relation("Referred")
  purchaseIntents  PurchaseIntent[]
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  title       String   @default("")
  comment     String   @default("")
  productId   String
  agentId     String
  txHash      String   @default("")
  helpful     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  agent       Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([agentId])
}

model Transaction {
  id           String   @id @default(cuid())
  type         String
  status       String   @default("confirmed")
  amountSats   Int
  discountSats Int      @default(0)
  buyerId      String
  sellerId     String
  productId    String?
  txHash       String   @default("")
  blockHeight  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id])
  buyer   Agent   @relation("BuyerTx", fields: [buyerId], references: [id])
  seller  Agent   @relation("SellerTx", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
}

// Financial intent created before any external broadcast.
// The composite unique key makes retries safe per authenticated buyer.
model PurchaseIntent {
  id                 String   @id @default(cuid())
  buyerId            String
  idempotencyKey     String
  requestHash        String
  status             String   @default("pending")
  currencyUnit       String   @default("sats")
  originalAmountSats Int
  discountAmountSats Int      @default(0)
  chargedAmountSats  Int
  externalTxId       String?
  failureCode        String?
  payloadJson        String   @default("{}")
  attempts           Int      @default(0)
  nextAttemptAt      DateTime @default(now())
  lastError          String   @default("")
  receiptJson        String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  buyer Agent @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  outbox PurchaseOutbox?

  @@unique([buyerId, idempotencyKey])
  @@unique([externalTxId])
  @@index([status, updatedAt])
  @@index([buyerId, createdAt])
}

model PurchaseOutbox {
  id          String   @id @default(cuid())
  intentId    String   @unique
  kind        String   @default("purchase_broadcast")
  status      String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lockedAt    DateTime?
  lastError   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  intent PurchaseIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
}

model ReferralReward {
  id             String   @id @default(cuid())
  referrerId     String
  referredId     String
  amountSats     Int      @default(2500)
  type           String   @default("signup_bonus")
  claimed        Boolean  @default(false)
  createdAt      DateTime @default(now())

  referrer Agent @relation("Referrer", fields: [referrerId], references: [id])
  referred Agent @relation("Referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([referredId])
}

// ============================================================================
// MCP Ecosystem — distributed as .aipkg packages (7th catalog segment)
// ============================================================================

model McpPackage {
  id             String   @id @default(cuid())
  name           String   @unique
  version        String
  displayName    String
  description    String
  category       String
  tags           String   @default("[]")  // JSON array
  iconEmoji      String   @default("🧩")
  authorAgent    String
  repoUrl        String   @default("")
  homepage       String   @default("")
  license        String   @default("MIT")
  transport      String   @default("stdio")
  command        String
  args           String   @default("[]")  // JSON array
  envSchema      String   @default("{}")  // JSON: name -> description
  capabilities   String   @default("{\"tools\":true,\"resources\":false,\"prompts\":false,\"logging\":true,\"sampling\":false}")
  manifestJson   String   // raw .aipkg manifest
  toolsJson      String   @default("[]")  // pre-declared tool list
  pricingModel   String   @default("free") // free | per-call | subscription
  priceSats      Int      @default(0)
  pricePerCallSats Int    @default(0)
  downloads      Int      @default(0)
  rating         Float    @default(4.5)
  pulsarEnergy   Float    @default(95.0)
  fitnessScore   Float    @default(85.0)
  verified       Boolean  @default(false)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installs   McpInstall[]
  tools      McpTool[]
  calls      McpCall[]
  ragSignals McpRagFeedback[]

  @@index([category])
  @@index([authorAgent])
}

model McpInstall {
  id          String   @id @default(cuid())
  packageId   String
  agentId     String?
  version     String
  enabled     Boolean  @default(true)
  envOverrides String  @default("{}")  // JSON
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package McpPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, agentId])
  @@index([agentId])
}

model McpTool {
  id          String   @id @default(cuid())
  packageId   String
  name        String
  description String   @default("")
  category    String   @default("")
  inputSchema String   @default("{}")  // JSON
  callCount   Int      @default(0)
  okCount     Int      @default(0)
  errCount    Int      @default(0)
  avgDurationMs Int    @default(0)
  discoveredAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package McpPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, name])
  @@index([category])
}

model McpCall {
  id          String   @id @default(cuid())
  packageId   String
  toolName    String
  agentId     String?
  ok          Boolean
  errorMsg    String   @default("")
  durationMs  Int
  payloadHash String   @default("")  // hash of arguments (no raw payload)
  ts          DateTime @default(now())

  package McpPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, ts])
  @@index([toolName])
  @@index([agentId])
}

model McpSelfHealEvent {
  id        String   @id @default(cuid())
  packageName String
  attempt   Int
  backoffMs Int
  reason    String   @default("")
  succeeded Boolean  @default(false)
  ts        DateTime @default(now())

  @@index([packageName, ts])
}

model McpRagFeedback {
  id         String   @id @default(cuid())
  packageId  String
  toolName   String
  signal     String   // "failure" | "low_rating" | "missing_capability" | "drift"
  weight     Float    @default(1.0)
  context    String   @default("{}")  // JSON
  resolved   Boolean  @default(false)
  ts         DateTime @default(now())

  package McpPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, signal])
  @@index([resolved])
}
