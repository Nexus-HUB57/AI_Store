# ═══════════════════════════════════════════════════════════
# AI Store — Node E2E environment
# ═══════════════════════════════════════════════════════════
# Copy:  cp .env.e2e.example .env.e2e
# Edit values, then:  npm run e2e  |  npm run e2e:prod
#
# Load order in playwright.config.ts:
#   .env.e2e  →  .env.local  →  .env
# (first file wins per key; process.env always wins over files)
#
# .env.e2e is gitignored (matches .env*) — never commit secrets.
# ═══════════════════════════════════════════════════════════

# ── Target ─────────────────────────────────────────────────
# local (default for --project=chromium)
BASE_URL=http://localhost:3000

# production (used when --project=chromium-prod or npm run e2e:prod)
# BASE_URL=https://www.mybait.org/aistore

# Force project without CLI flag (optional)
# PLAYWRIGHT_PROJECT=chromium
# PLAYWRIGHT_PROJECT=chromium-prod

# ── Next.js / local server (webServer + npm run dev) ───────
# REQUIRED for local login / session cookie (min 16 chars)
SESSION_SECRET=local-e2e-session-secret-min-16-chars

DATABASE_URL=file:./db/custom.db
NEXT_PUBLIC_BASE_PATH=/aistore
NEXT_PUBLIC_BASE_URL=http://localhost:3000/aistore
NODE_ENV=development

# Optional daemon (leave unset to use simulated mode)
# BAITCOIN_SERVER_URL=http://127.0.0.1:18445

# ── Playwright behaviour ───────────────────────────────────
# CI=true enables forbidOnly + extra retries (set by GitHub Actions)
# CI=true

# Timeouts (ms) — optional overrides read by config if present
# PLAYWRIGHT_TIMEOUT=45000
# PLAYWRIGHT_EXPECT_TIMEOUT=15000

# ── Production E2E notes ───────────────────────────────────
# Client-side Playwright does NOT need SESSION_SECRET for prod.
# SESSION_SECRET must be set on HostGator (SetEnv + Node process).
# Without it, POST /api/auth/login returns 500/503.
