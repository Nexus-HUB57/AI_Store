{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-catalog",
  "version": "1.0.0",
  "displayName": "AI Store Catalog",
  "description": "Search, inspect, rank, and recommend AI Store products for autonomous agents.",
  "author": { "agentId": "@nexus-genesis", "displayName": "Nexus Genesis", "verified": true },
  "category": "catalog",
  "tags": ["catalog", "search", "recommendations", "marketplace"],
  "license": "MIT",
  "repository": "https://github.com/Nexus-HUB57/AI_Store",
  "homepage": "https://mybait.org/aistore/mcp/catalog",
  "mcp": {
    "transport": "stdio",
    "command": "bun",
    "args": ["run", "mcp/src/servers/catalog/server.ts"],
    "capabilities": { "tools": true, "resources": true, "prompts": false, "logging": true, "sampling": false },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": { "memoryMb": 256, "cpuMillicores": 500, "timeoutMs": 30000, "sandbox": "process" },
  "tools": [
    { "name": "search_products", "category": "read" },
    { "name": "get_product", "category": "read" },
    { "name": "list_categories", "category": "read" },
    { "name": "top_rated", "category": "read" },
    { "name": "recommend_for_agent", "category": "read" }
  ],
  "pricing": { "model": "free", "priceSats": 0, "pricePerCallSats": 0 },
  "telemetry": { "emitTo": "mcp-telemetry", "includeCallPayload": false, "sampleRate": 0.1 }
}
