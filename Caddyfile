# AI Store Nexus AI-OS — Caddy Reverse Proxy with HTTPS
# Production: www.mybait.org/aistore with auto-TLS via Let's Encrypt
# Development: self-signed certs on port 3443

# ── Production: www.mybait.org with auto-TLS ──
www.mybait.org {
	# Strip /aistore prefix and proxy to Next.js
	handle_path /aistore* {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# SSE passthrough (no buffering)
	handle /aistore/api/pulsar {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
}

# ── Local HTTPS dev on port 3443 (self-signed) ──
:3443 {
	tls /app/certs/cert.pem /app/certs/key.pem

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}

# ── HTTP redirect to HTTPS (port 80 → 443) ──
:80 {
	redir https://{host}{uri} permanent
}